{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build.ps1",
                "-NoRun"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "run",
            "type": "shell",
            "command": "${workspaceFolder}/build/main.exe",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "-I${workspaceFolder}/src",
                "-I${workspaceFolder}/lib/imgui",
                "-I${workspaceFolder}/lib/include",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Config.cpp",
                "${workspaceFolder}/src/Boot.cpp",
                "${workspaceFolder}/src/Desktop.cpp",
                "${workspaceFolder}/src/Taskbar.cpp",
                "${workspaceFolder}/src/TaskManager.cpp",
                "${workspaceFolder}/src/AppScreen1.cpp",
                "${workspaceFolder}/src/AppScreen2.cpp",
                "${workspaceFolder}/lib/imgui/imgui.cpp",
                "${workspaceFolder}/lib/imgui/imgui_demo.cpp",
                "${workspaceFolder}/lib/imgui/imgui_draw.cpp",
                "${workspaceFolder}/lib/imgui/imgui_impl_glfw.cpp",
                "${workspaceFolder}/lib/imgui/imgui_impl_opengl3.cpp",
                "${workspaceFolder}/lib/imgui/imgui_tables.cpp",
                "${workspaceFolder}/lib/imgui/imgui_widgets.cpp",
                "-o",
                "${workspaceFolder}\\build\\main.exe",
                "-L${workspaceFolder}/lib/lib-vc2022",
                "-l:glfw3.dll",
                "-lopengl32",
                "-lgdi32",
                "-limm32"
            ],
            "options": {
                "cwd": "C:/msys64/ucrt64/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}